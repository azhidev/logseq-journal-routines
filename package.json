{
  "name": "logseq-journal-routines",
  "version": "0.5.0",
  "private": true,
  "description": "Lightweight weekly/monthly routine pages in Logseq's sidebar; Gregorian standalone, optional Jalali.",
  "type": "module",
  "main": "index.html",
  "icon": "./icon.png",
  "scripts": {
    "build": "esbuild src/index.js --bundle --format=iife --platform=browser --outfile=dist/index.js",
    "test": "node --test src/*.test.js",
    "test:browser": "node scripts/validate_routines.cjs",
    "test:release": "python3 -B -m unittest discover -s scripts -p 'test_package_release.py'",
    "release:package": "python3 -B scripts/package_release.py"
  },
  "dependencies": {
    "@logseq/libs": "0.0.17"
  },
  "devDependencies": {
    "esbuild": "0.28.2"
  },
  "logseq": {
    "id": "journal-routines",
    "title": "Journal & Routines"
  }
}
